# Secret shared only by the MCP client and this server.
MCP_BEARER_TOKEN=replace-with-a-long-random-token

# Banco General Zona Segura credentials. These remain server-side.
BG_USERNAME=your-zona-segura-username
BG_PASSWORD=your-zona-segura-password
BG_SECURITY_ANSWERS_JSON={"What is your security question?":"your-answer","What is another security question?":"your-other-answer"}

# Deprecated compatibility fallback. Prefer BG_SECURITY_ANSWERS_JSON.
# BG_SECURITY_ANSWER=your-single-security-answer

# Optional: useful only for local development with an existing Chromium.
# BG_CHROMIUM_EXECUTABLE_PATH=/absolute/path/to/chromium
